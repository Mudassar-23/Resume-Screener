*.db
*.sqlite
*.sqlite3

# ─── UPLOADED RESUME FILES ────────────────────────────────────────────────────
backend/uploads/

# ─── DISTRIBUTION / BUILD ─────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ─── IDE & EDITOR FILES ───────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── OS GENERATED FILES ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── LOGS ─────────────────────────────────────────────────────────────────────
*.log
logs/
