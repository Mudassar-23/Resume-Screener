# ─── ENVIRONMENT VARIABLES & SECRETS ─────────────────────────────────────────
# Never commit API keys, passwords, or credentials
backend/.env
.env
.env.*
*.env

# ─── PYTHON VIRTUAL ENVIRONMENT ───────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── PYTHON CACHE & COMPILED FILES ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ─── DATABASE FILES ───────────────────────────────────────────────────────────
